# Copy to .env and adjust. Every line is optional.
OLLAMA_HOST=http://127.0.0.1:11434
ADIGPT_CHAT_MODEL=qwen3.5:9b
ADIGPT_EMBED_MODEL=nomic-embed-text
ADIGPT_NUM_CTX=8192
ADIGPT_KEEP_ALIVE=30m
# Folders that may be indexed (":" separated; ";" on Windows). Default: your home folder.
# ADIGPT_ALLOWED_DIRS=/Users/you/Documents:/Users/you/code
# ADIGPT_MIN_SIMILARITY=0.25
# ADIGPT_PORT=8000
